# TwoBudz Hostinger LiteSpeed / Apache Routing Configuration
Options -MultiViews
RewriteEngine On
RewriteBase /

# Preserve existing search URLs when moving the site to cbdhurst.com.
RewriteCond %{HTTP_HOST} ^(www\.)?twobudz\.com$ [NC]
RewriteRule ^ https://cbdhurst.com%{REQUEST_URI} [R=301,L,NE]

# 1. Allow API Bridge PHP requests to pass through directly
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# 2. Resolve static route directories before serving other files
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# 3. If the requested file exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 4. Check for .html file (e.g. /admin -> /admin.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Fallback all other client requests to index.html so React can handle dynamic routes
RewriteRule ^ index.html [L]
