# CBD American Shaman of Hurst Hostinger LiteSpeed / Apache Routing Configuration
Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Allow API Bridge PHP requests to pass through directly
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# 2. Redirect legacy / alias domains (twobudz.com, shophurstcbd.com, www.cbdhurst.com) to https://cbdhurst.com
RewriteCond %{HTTP_HOST} ^(www\.)?(twobudz\.com|shophurstcbd\.com)$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.cbdhurst\.com$ [NC]
RewriteRule ^ https://cbdhurst.com%{REQUEST_URI} [R=301,L,NE]

# 3. Resolve static route directories before serving other files
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# 4. If the requested file exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. Check for .html file (e.g. /admin -> /admin.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 6. Fallback all other client requests to index.html so React can handle dynamic routes
RewriteRule ^ index.html [L]
